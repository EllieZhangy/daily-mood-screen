{
  "style": "apple_journal",

  "background": {
    "type": "gradient",
    "top":    [252, 250, 247],
    "bottom": [238, 233, 226]
  },

  "typography": {
    "font":         "PingFang SC",
    "quote_size":   68,
    "metadata_size": 22,
    "line_spacing": 1.6
  },

  "layout": {
    "alignment":       "left",
    "text_width_ratio": 0.55,
    "vertical_offset": -60,
    "meta_gap":        72,
    "meta_line_gap":   16
  },

  "color_palette": {
    "text_primary":   [36, 32, 28],
    "text_secondary": [122, 114, 104]
  },

  "render_notes": "Clean and restrained, inspired by Apple's own journal aesthetic. Warm off-white background with generous whitespace. Text sits left-aligned in the upper-center area. Metadata is small and unobtrusive."
}
